# ============================================================
# FeatherQuest Bot — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.

# ---- Required ----

# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Discord Application/Client ID (from the same application)
DISCORD_CLIENT_ID=

# PostgreSQL connection string (same database the web app uses)
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# ---- Optional ----

# Discord Client Secret (only needed if using OAuth2 web login)
# DISCORD_CLIENT_SECRET=

# Session secret for JWT tokens (only needed if sharing with web app)
# SESSION_SECRET=
